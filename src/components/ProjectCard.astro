---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  title: string;
  members?: string[];
  image: ImageMetadata;
  url: string;
  description?: string;
}

const { title, image, url, description, members = [] } = Astro.props;
---

<a href={url} class="project-card" target="_blank" rel="noopener noreferrer">
  <div class="card-image">
    <Image src={image} alt={title} width={336} height={336} loading="lazy" />
  </div>
  <h2 class="card-title">{title}</h2>
  {members.length > 0 && <p class="card-members">{members.join(" • ")}</p>}
  {description && <p class="card-description">{description}</p>}
</a>
