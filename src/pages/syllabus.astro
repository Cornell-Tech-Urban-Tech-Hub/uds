---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Syllabus — Street Knowledge">
  <Header />
  <main>
    <div class="page-layout">
      <div class="page-left">
        <section class="page-header">
          <h1>Syllabus</h1>
          <p class="subtitle">Spring 2026</p>
        </section>

        <section class="syllabus-section">
          <h2>Course Overview</h2>
          <p>
            How can human-centered design processes coupled with modern technologies support urban design? In this seminar, student teams develop evidence-based, data-driven strategies for New York City's Business Improvement Districts.
          </p>
        </section>

        <section class="syllabus-section">
          <h2>Learning Objectives</h2>
          <ul>
            <li>Understand urban systems design methodologies</li>
            <li>Apply data-driven approaches to urban challenges</li>
            <li>Develop collaborative design solutions</li>
            <li>Communicate findings to stakeholders</li>
          </ul>
        </section>

        <section class="syllabus-section">
          <h2>Course Requirements</h2>
          <p>
            <strong>Participation</strong> — Active engagement in team meetings and presentations<br/>
            <strong>Research & Analysis</strong> — Data collection and urban analytics<br/>
            <strong>Project Deliverables</strong> — Design proposals, simulations, and public engagement materials
          </p>
        </section>

        <section class="syllabus-section">
          <h2>Four Lenses Framework</h2>
          <div class="lenses">
            <div class="lens">
              <p class="lens-number">01</p>
              <p class="lens-title">Insight</p>
              <p class="lens-desc">Understanding the current state through data collection, mapping, and urban analytics</p>
            </div>
            <div class="lens">
              <p class="lens-number">02</p>
              <p class="lens-title">Transformation</p>
              <p class="lens-desc">Proposing iterative, collaborative methods for urban intervention and scenario testing</p>
            </div>
            <div class="lens">
              <p class="lens-number">03</p>
              <p class="lens-title">Prediction</p>
              <p class="lens-desc">Forecasting impact through simulation, agent modeling, and generative methods</p>
            </div>
            <div class="lens">
              <p class="lens-number">04</p>
              <p class="lens-title">Consensus</p>
              <p class="lens-desc">Designing public-facing processes for collaborative decision-making</p>
            </div>
          </div>
        </section>
      </div>

      <div class="page-right"></div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 48px;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 400;
    margin-bottom: 8px;
  }

  .subtitle {
    color: var(--color-text-secondary);
    font-size: 18px;
  }

  .syllabus-section {
    margin-bottom: 40px;
  }

  .syllabus-section h2 {
    font-family: var(--font-serif);
    font-size: 24px;
    font-weight: 400;
    margin-bottom: 16px;
  }

  .syllabus-section ul {
    list-style: none;
    padding-left: 0;
  }

  .syllabus-section li {
    margin-bottom: 12px;
    padding-left: 24px;
    position: relative;
  }

  .syllabus-section li::before {
    content: '→';
    position: absolute;
    left: 0;
    color: var(--color-text-secondary);
  }

  .lenses {
    display: grid;
    grid-template-columns: 1fr;
    gap: 24px;
    margin-top: 24px;
  }

  .lens {
    padding: 20px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }

  .lens-number {
    font-size: 14px;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 8px;
  }

  .lens-title {
    font-family: var(--font-serif);
    font-size: 18px;
    font-weight: 400;
    margin-bottom: 8px;
  }

  .lens-desc {
    font-size: 14px;
    color: var(--color-text-secondary);
    margin: 0;
  }
</style>
