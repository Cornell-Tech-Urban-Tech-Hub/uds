---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { getCollection } from 'astro:content';

const teamMembers = (await getCollection('team')).sort((a, b) => {
  if (a.data.order !== undefined && b.data.order !== undefined)
    return a.data.order - b.data.order;
  return a.data.name.localeCompare(b.data.name);
});
---

<BaseLayout title="Team — Street Knowledge">
  <Header />
  <main>
    <div class="page-layout">
      <div class="page-left">
        <section class="page-header">
          <h1>Team</h1>
          <p class="subtitle">Instructors & Teaching Team</p>
        </section>
      </div>

      <div class="page-right">
        <div class="team-grid">
          {teamMembers.map((member) => (
            <div class="team-card">
              <h3 class="team-name">{member.data.name}</h3>
              <p class="team-role">{member.data.role}</p>
              <p class="team-bio">{member.data.bio}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 48px;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 400;
    margin-bottom: 8px;
  }

  .subtitle {
    color: var(--color-text-secondary);
    font-size: 18px;
  }

  .team-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
  }

  .team-card {
    padding: 24px;
    border: 1px solid var(--color-rule);
    background: var(--color-surface);
  }

  .team-name {
    font-family: var(--font-serif);
    font-size: 20px;
    font-weight: 400;
    margin-bottom: 4px;
  }

  .team-role {
    font-size: 13px;
    font-weight: 500;
    color: var(--color-text-secondary);
    margin-bottom: 12px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .team-bio {
    font-size: 14px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
