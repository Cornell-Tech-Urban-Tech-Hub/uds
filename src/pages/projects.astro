---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectGrid from '../components/ProjectGrid.astro';
import { getCollection } from 'astro:content';

const projects = (await getCollection('projects'))
  .filter((p) => !p.id.startsWith('_'))
  .sort((a, b) => {
    if (a.data.order !== undefined && b.data.order !== undefined)
      return a.data.order - b.data.order;
    return a.data.title.localeCompare(b.data.title);
  });
---

<BaseLayout title="Projects — Street Knowledge">
  <Header />
  <main>
    <div class="page-layout">
      <div class="page-left">
        <section class="page-header">
          <h1>Projects</h1>
          <p class="subtitle">Student-led urban design explorations</p>
        </section>

        <section class="projects-intro">
          <p>
            Each team develops evidence-based, data-driven strategies for New York City's Business Improvement Districts, proposing forward-thinking interventions across sustainability, mobility, equity, and resilience.
          </p>
        </section>
      </div>

      <div class="page-right">
        <ProjectGrid projects={projects} />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style>
  .page-header {
    margin-bottom: 48px;
  }

  h1 {
    font-family: var(--font-serif);
    font-size: 48px;
    font-weight: 400;
    margin-bottom: 8px;
  }

  .subtitle {
    color: var(--color-text-secondary);
    font-size: 18px;
  }

  .projects-intro {
    margin-bottom: 40px;
  }

  .projects-intro p {
    font-size: 16px;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
</style>
